{
  "name": "magpie-gray-privacy",
  "version": "0.1.0",
  "private": true,
  "description": "Connect Magpie's privacy engine to a local Gray Privacy service",
  "magpie": {
    "name": "Gray Privacy",
    "privacy": {
      "id": "gray",
      "name": "Gray Privacy",
      "protocol": "http-scan-v1",
      "statePath": "/api/v1/privacy/state",
      "scanPath": "/api/v1/privacy/scan",
      "tokenHeader": "X-Gray-Host-Token"
    }
  }
}
